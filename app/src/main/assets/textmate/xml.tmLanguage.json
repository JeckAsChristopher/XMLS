{
  "name": "XML",
  "scopeName": "text.xml",
  "fileTypes": ["xml", "xsl", "xslt", "xsd", "rss", "svg", "plist"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#cdata" },
    { "include": "#doctype" },
    { "include": "#processing" },
    { "include": "#tag" },
    { "include": "#entity" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.xml",
      "begin": "<!--",
      "end": "-->",
      "captures": {
        "0": { "name": "punctuation.definition.comment.xml" }
      }
    },
    "cdata": {
      "name": "string.unquoted.cdata.xml",
      "begin": "<!\\[CDATA\\[",
      "end": "\\]\\]>",
      "captures": {
        "0": { "name": "punctuation.definition.string.xml" }
      }
    },
    "doctype": {
      "name": "meta.tag.sgml.doctype.xml",
      "begin": "<!DOCTYPE",
      "end": ">",
      "captures": {
        "0": { "name": "entity.name.tag.xml" }
      }
    },
    "processing": {
      "name": "meta.tag.preprocessor.xml",
      "begin": "<\\?",
      "end": "\\?>",
      "captures": {
        "0": { "name": "punctuation.definition.tag.xml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tag": {
      "patterns": [
        { "include": "#tag-open" },
        { "include": "#tag-close" },
        { "include": "#tag-self-close" }
      ]
    },
    "tag-open": {
      "name": "meta.tag.xml",
      "begin": "(<)([a-zA-Z_][a-zA-Z0-9_.-]*(?::[a-zA-Z_][a-zA-Z0-9_.-]*)?)",
      "end": "(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.xml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.xml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "tag-close": {
      "name": "meta.tag.xml",
      "match": "(</)([a-zA-Z_][a-zA-Z0-9_.-]*(?::[a-zA-Z_][a-zA-Z0-9_.-]*)?)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.xml" },
        "3": { "name": "punctuation.definition.tag.end.xml" }
      }
    },
    "tag-self-close": {
      "name": "meta.tag.xml",
      "begin": "(<)([a-zA-Z_][a-zA-Z0-9_.-]*(?::[a-zA-Z_][a-zA-Z0-9_.-]*)?)",
      "end": "(/>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.xml" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.xml" }
      },
      "patterns": [
        { "include": "#attribute" }
      ]
    },
    "attribute": {
      "patterns": [
        {
          "name": "meta.attribute.xml",
          "match": "([a-zA-Z_][a-zA-Z0-9_.-]*(?::[a-zA-Z_][a-zA-Z0-9_.-]*)?)\\s*(=)\\s*(\"[^\"]*\"|'[^']*')",
          "captures": {
            "1": { "name": "entity.other.attribute-name.xml" },
            "2": { "name": "punctuation.separator.key-value.xml" },
            "3": { "name": "string.quoted.xml" }
          }
        },
        {
          "name": "entity.other.attribute-name.xml",
          "match": "[a-zA-Z_][a-zA-Z0-9_.-]*(?::[a-zA-Z_][a-zA-Z0-9_.-]*)?"
        }
      ]
    },
    "entity": {
      "name": "constant.character.entity.xml",
      "match": "&[a-zA-Z0-9]+;|&#[0-9]+;|&#x[0-9a-fA-F]+;"
    }
  }
}
